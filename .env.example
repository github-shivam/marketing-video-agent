# ──────────────────────────────────────────────────────────────────────────
#  Instagram Marketing Agent — configuration
#  Copy to .env and fill in. NEVER commit .env (it is gitignored).
# ──────────────────────────────────────────────────────────────────────────

# ── Safety ────────────────────────────────────────────────────────────────
# true  = skip the Instagram API call entirely, return "dry-run"
# false = REALLY POST to Instagram. Keep true during development.
DRY_RUN=true

# ── Text models on AWS Bedrock ────────────────────────────────────────────
# AWS_PROFILE is read by boto3 itself (run `aws sso login --profile ...`).
BEDROCK_TEXT_REGION=us-east-1
AWS_PROFILE=avahi-genAI-stage
MODEL_TEMPERATURE=0.7

# Every node names its own model. There is NO built-in default: a node with no
# model fails at startup with a clear error. Newer Claude models are only
# available through an inference profile, so use the `us.` form of the ID.
#   classify  turns the request into a brief       a small, fast model is enough
#   research  multi-step tool loop                 the most demanding: use a strong one
#   writer    writes the screenplay                quality matters most here
#   critic    scores it strictly                   a strong model
#   dialogue  caption and hashtags                 a small, fast model is enough
#   converse  reads WhatsApp replies (optional)    a small, fast model is enough
MODEL_CLASSIFY=us.anthropic.claude-haiku-4-5-20251001-v1:0
MODEL_RESEARCH=us.anthropic.claude-sonnet-4-6
MODEL_WRITER=us.anthropic.claude-sonnet-4-6
MODEL_CRITIC=us.anthropic.claude-sonnet-4-6
MODEL_DIALOGUE=us.anthropic.claude-haiku-4-5-20251001-v1:0
MODEL_CONVERSE=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Optional: one shared model for any node left blank above. Leave unset to
# require every node to be named.
# MODEL=

# ── Script style ──────────────────────────────────────────────────────────
# SCRIPT_LANGUAGE sets the language of the SPOKEN dialogue, caption and
# on-screen text. Visual descriptions stay in English because they instruct
# the model rather than being spoken.
# CAVEAT: Google documents English as the only language Veo's speech has been
# evaluated on. Hindi and others usually work but quality varies - test before
# relying on it. If the speech is poor, the fallback is ambient-only audio
# plus a separate voiceover track mixed in with ffmpeg.
SCRIPT_LANGUAGE=English

# Whether a person speaks to camera or the visuals and sound carry the video is
# decided per request by the intent classifier, not by a setting.

# Optional: animate a photo you supply as the FIRST FRAME instead of
# generating the opening shot from text. Use this to put yourself in the reel.
# Leave blank for text-to-video. Note that supplying an image switches
# person_generation to "allow_adult" automatically, as Veo requires.
VEO_IMAGE=

# Speaking pace used to size each beat's word budget. The writer is told how
# many spoken words fit in each clip, and to use nearly all of them.
#   140-160 = conversational    175 = brisk presenter    200+ = fast ad read
# Too low and the model drawls, leaving dead air in a 15s clip.
SPEECH_PACE_WPM=175

# ── Writer/critic loop ────────────────────────────────────────────────────
SCORE_THRESHOLD=8          # critic score (0-10) required to exit the loop
MAX_ITERATIONS=3           # max writer<->critic rounds before forcing exit

# ── Which video model the prompts are written for ────────────────────────
# veo      = Veo 3.1 (live). 8s base clip + 7s extensions, timestamped shots.
# seedance = Seedance 2.5. One pass up to 30s, labelled shots with its own
#            bracket syntax. The prompt format is complete, but its API is not
#            wired in yet, so this runs against the free offline stub.
# Override per run with:  python main.py "..." --model seedance
VIDEO_MODEL=veo

# ── How long the video is ─────────────────────────────────────────────────
# A person asks per video: in a WhatsApp message ("make it 20 seconds"), with
# `--seconds` on the CLI, or `seconds` in the API. 4 to 30 seconds. This is the
# length used when they do not say. Out-of-range requests are clamped, and the
# person is told.
#
# Veo makes a base clip (4, 6 or 8s) and extends it in steps of exactly 7s, so a
# length is built from those and the video is trimmed to the exact length asked
# for. You pay for what is GENERATED, which can be a few seconds more than is
# kept (20s is generated as 8+7+7 = 22s). The script is written to finish inside
# the kept time. A length that would keep only one second of a final extension
# (9, 16, 23, 30) is made one second shorter instead, so 30 is made as 29.
VIDEO_SECONDS_DEFAULT=15

# ── Video: Veo 3.1 Fast (Vertex AI) ───────────────────────────────────────
#
# IMPORTANT: the extension call must pass aspect_ratio explicitly. Omit it and
# the API defaults to 16:9, then rejects your 9:16 input with the misleading
# "Aspect ratio of the input video must be 16:9, but got: 9:16". Vertical
# extension works fine once the output ratio matches the source. (Observed on
# the Gemini API; the code restates it on Vertex too.)
#
# Extension is 720p-only and needs an 8s base, so anything over 8s is 720x1280.
# A native 1080x1920 video (VEO_RESOLUTION=1080p) is therefore limited to 8s, and
# a longer request then fails before anything is billed.
#
# person_generation: text-to-video AND extension both require "allow_all".
# (allow_adult is for image-to-video / interpolation / reference images.)
# REGIONAL: in the EU, UK, CH and MENA, "allow_adult" is the only permitted
# value - which conflicts with text-to-video. Running from those regions
# needs an image-to-video flow instead.
#
# 4k is also available (Veo 3.1 & Fast, 8s only, not with extension) but
# Instagram caps at 1080p, so it is pure cost with no benefit here.
#
# AUTH: Google Cloud credentials, like AWS_PROFILE for Bedrock. There is no API
# key. Locally, run once:
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project <project>
#   gcloud services enable aiplatform.googleapis.com
# On a server use a service account (GOOGLE_APPLICATION_CREDENTIALS or an
# attached identity) with roles/aiplatform.user on the project and
# roles/storage.objectAdmin on the bucket.
#
# Vertex writes every clip to Cloud Storage, so VEO_GCS_BUCKET is required and
# clips stay there until you delete them: add a lifecycle rule (e.g. delete
# after 7 days). Leave the project or bucket blank to use the free stub.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VEO_GCS_BUCKET=
# GA IDs: veo-3.1-fast-generate-001, veo-3.1-generate-001
VEO_MODEL=veo-3.1-fast-generate-001
VEO_RESOLUTION=720p
# Direct each clip as [00:00-00:02] timestamped shots, per Google's Veo 3.1
# guide. Set false to fall back to plain "Shot 1:" labels if timestamps ever
# misbehave with extension - this combination has not been verified live.
VEO_TIMESTAMPS=true
VEO_ASPECT_RATIO=9:16
VEO_PERSON_GENERATION=allow_all
# Safety filters intermittently block a generation, usually over audio.
# Blocked attempts are NOT billed, so retrying them is free.
VEO_BLOCK_RETRIES=2
VEO_POLL_INTERVAL=10       # seconds; generation takes 11s to ~6min
VEO_TIMEOUT=600            # seconds to wait for one generation

# ── Reading uploaded photos, video and audio (WhatsApp) ───────────────────
# A person can send files before their request; the video then takes their look,
# features the person in them, and follows the audio. Gemini on Vertex AI reads
# them, with the same Google Cloud login and project as Veo (no API key). It is
# the model that takes images, video and audio natively. Files are kept here
# until the run ends, then deleted.
ASSET_MODEL=gemini-2.5-flash
UPLOADS_DIR=uploads

# ── Research: Bright Data MCP ─────────────────────────────────────────────
# Free tier = 5,000 requests/month. Leave BRIGHTDATA_API_TOKEN blank to skip
# the server entirely (research then works from the request, and the page the
# user linked, alone). Links are always fetched directly; this token only adds
# competitor and trend research.
BRIGHTDATA_API_TOKEN=
# FREE TIER = "Search & Extract" only: 5,000 calls/month covering
#   search_engine, search_engine_batch, scrape_as_markdown, scrape_batch,
#   scrape_as_html, extract, session_stats
# The web_data_* tools (Instagram/TikTok/LinkedIn datasets) are Web Scraper
# API - a separate PAID product. They are deliberately excluded so a research
# run cannot quietly bill you. Unset, the server exposes 29 tools, most of
# them paid and irrelevant. TOOLS takes precedence over GROUPS.
BRIGHTDATA_TOOLS=search_engine,search_engine_batch,scrape_as_markdown,scrape_batch,extract
BRIGHTDATA_GROUPS=
BRIGHTDATA_RATE_LIMIT=100/1h
BRIGHTDATA_MAX_RETRIES=2

# ── Upload strategy ───────────────────────────────────────────────────────
# resumable = POST the local file's bytes straight to Meta. No hosting needed,
#             so S3 can be left blank. Requires an app using Facebook Login
#             for Business (which the Page-linked setup below gives you).
# url       = upload to S3 and hand Instagram a presigned URL to fetch.
UPLOAD_STRATEGY=resumable

# ── Storage: S3 (only used when UPLOAD_STRATEGY=url) ──────────────────────
S3_BUCKET=
S3_PREFIX=instagram-agent
S3_REGION=us-east-1
PRESIGN_EXPIRY=3600        # seconds the presigned URL stays valid

# ── Instagram Graph API ───────────────────────────────────────────────────
# Requires: Instagram Business/Creator account linked to a Facebook Page,
# a Meta app with instagram_content_publish, and a long-lived access token.
# See README for the full setup walkthrough.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_API_VERSION=v25.0
# Which login flow the token came from:
#   https://graph.facebook.com   Facebook Login for Business (Page-linked token).
#                                Supports UPLOAD_STRATEGY=resumable.
#   https://graph.instagram.com  Instagram Login (token from the app dashboard's
#                                "Generate token"). No Facebook Page needed, but
#                                resumable upload is not documented for it, so
#                                set UPLOAD_STRATEGY=url and fill in S3_BUCKET.
IG_GRAPH_HOST=https://graph.facebook.com
IG_POLL_INTERVAL=5         # seconds between status_code checks
IG_POLL_TIMEOUT=300        # docs advise polling no more than ~5 minutes

# ── WhatsApp chat front end (optional) ────────────────────────────────────
# Lets people use the pipeline from a WhatsApp chat: send a topic or link, get
# the prompts to approve, get the video back, and say in plain words whether to
# post it. Leave ALL of these blank to switch it off; the webhook routes then do
# not exist. Setting some but not all makes the server refuse to start.
# Needs a public HTTPS URL for /whatsapp/webhook (see the README).
WHATSAPP_ACCESS_TOKEN=          # permanent System User token, not the 24h test one
WHATSAPP_PHONE_NUMBER_ID=       # the number's ID in WhatsApp Manager (not the number)
WHATSAPP_APP_SECRET=            # Meta app secret; every delivery is signed with it
WHATSAPP_VERIFY_TOKEN=          # any string you choose; paste the same one into Meta
WHATSAPP_API_VERSION=v25.0
# Who may use the bot, comma separated, country code first, digits only.
#   WHATSAPP_ALLOWED_NUMBERS=919800000001,919800000002
# Every approved request spends Veo money and a "yes" posts to YOUR Instagram,
# so this is required. "*" opens it to anyone who messages the number.
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_MAX_RUNS_PER_DAY=10    # per phone number, rolling 24h
CONVERSATIONS_DB=conversations.sqlite

# ── HTTP API (uvicorn api:create_app --factory) ───────────────────────────
# Callers send this in an X-API-Key header. The server refuses to start
# without it, because every approved request spends real Veo money.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# ── Local ─────────────────────────────────────────────────────────────────
CHECKPOINT_DB=checkpoints.sqlite
OUTPUT_DIR=output
LOG_LEVEL=INFO
